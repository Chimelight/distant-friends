      ]
    },
    "tr": {
      "gloss": "ilk tanışma",
      "variants": [
        { "text": "Memnun oldum", "note": "Short, everyday \"pleased (to meet you).\"" },
        { "text": "Tanıştığımıza memnun oldum", "tone": "polite", "note": "Lit. \"pleased that we have met.\"" }
      ]
