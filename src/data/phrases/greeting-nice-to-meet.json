{
  "id": "greeting-nice-to-meet",
  "scene": "greetings",
  "order": 6,
  "trans": {
    "zh": {
      "gloss": "初次见面",
      "variants": [
        { "text": "很高兴认识你", "rom": "hěn gāoxìng rènshi nǐ" },
        { "text": "幸会", "rom": "xìnghuì", "tone": "polite", "note": "Literary/formal; warm respect on first meeting." }
      ]
    },
    "ja": {
      "gloss": "初対面の挨拶",
      "variants": [
        { "text": "はじめまして", "rom": "hajimemashite", "note": "Standard first-meeting greeting." },
        { "text": "よろしくお願いします", "rom": "yoroshiku onegai shimasu", "tone": "polite", "note": "Often paired after はじめまして; \"I look forward to (knowing you).\"" }
      ]
    },
    "ko": {
      "gloss": "첫 인사",
      "variants": [
        { "text": "만나서 반가워요", "rom": "mannaseo bangawoyo", "note": "Lit. \"glad to meet (you).\"" },
        { "text": "처음 뵙겠습니다", "rom": "cheoeum boepgesseumnida", "tone": "polite", "note": "Formal first-meeting greeting." }
      ]
    },
    "en": {
      "gloss": "first meeting",
      "variants": [
        { "text": "Nice to meet you" },
        { "text": "Pleased to meet you", "tone": "polite" }
      ]
    },
    "de": {
      "gloss": "Erstbegegnung",
      "variants": [
        { "text": "Freut mich", "tone": "casual", "note": "Short for \"freut mich, dich kennenzulernen.\"" },
        { "text": "Schön, Sie kennenzulernen", "tone": "polite", "note": "Lit. \"nice to get to know you.\"" }
      ]
    },
    "es": {
