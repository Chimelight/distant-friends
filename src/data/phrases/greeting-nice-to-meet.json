        { "text": "Lieto di conoscerla", "tone": "polite", "speakerGender": "m" },
        { "text": "Lieta di conoscerla", "tone": "polite", "speakerGender": "f" }
      ]
    },
    "ru": {
      "gloss": "знакомство",
      "variants": [
        { "text": "Приятно познакомиться", "rom": "priyatno poznakomit'sya" },
        { "text": "Очень приятно", "rom": "ochen' priyatno", "tone": "casual", "note": "Lit. \"very pleasant\"; common short form." }
