      ]
    },
    "hi": {
      "gloss": "पहली मुलाक़ात",
      "variants": [
        { "text": "आपसे मिलकर खुशी हुई", "rom": "āpse milkar khushī huī", "tone": "polite", "note": "Lit. \"meeting you brought happiness.\"" },
        { "text": "मिलकर अच्छा लगा", "rom": "milkar achchhā lagā", "note": "Lit. \"it felt good to meet (you).\"" }
      ]
    },
    "bn": {
      "gloss": "প্রথম দেখা",
      "variants": [
        { "text": "আপনার সাথে দেখা হয়ে ভালো লাগলো", "rom": "āpnār śathe dekha hoye bhalo laglo", "tone": "polite", "note": "Lit. \"it was good to meet you.\"" },
        { "text": "তোমার সাথে দেখা হয়ে ভালো লাগলো", "rom": "tomār śathe dekha hoye bhalo laglo", "note": "Same warmth, peer-pronoun form." }
      ]
    },
    "id": {
      "gloss": "perkenalan",
      "variants": [
        { "text": "Senang bertemu denganmu", "tone": "casual" },
        { "text": "Senang bertemu Anda", "tone": "polite" }
      ]
    },
    "ms": {
      "gloss": "perkenalan",
      "variants": [
        { "text": "Selamat berkenalan", "note": "Lit. \"happy acquaintance.\"" },
        { "text": "Gembira bertemu dengan anda", "tone": "polite" }
      ]
    },
    "fil": {
      "gloss": "unang pagkikita",
      "variants": [
        { "text": "Ikinagagalak kong makilala ka", "tone": "polite", "note": "Lit. \"I am delighted to meet you.\"" },
        { "text": "Nice to meet you", "tone": "casual", "note": "English-borrowed; very common in everyday speech." }
      ]
    },
    "vi": {
      "gloss": "lần đầu gặp mặt",
      "variants": [
        { "text": "Rất vui được gặp bạn", "note": "Standard \"nice to meet you\"; bạn = peer pronoun." },
        { "text": "Hân hạnh được gặp bạn", "tone": "polite", "note": "More formal; lit. \"honored to meet you.\"" }
      ]
    },
    "th": {
      "gloss": "การพบกันครั้งแรก",
      "variants": [
        { "text": "ยินดีที่ได้รู้จัก", "rom": "yindee thi dai rujak", "note": "Standard \"nice to meet you.\"" },
        { "text": "ยินดีที่ได้รู้จักครับ", "rom": "yindee thi dai rujak khrap", "tone": "polite", "speakerGender": "m", "note": "With polite particle ครับ for male speakers." },
        { "text": "ยินดีที่ได้รู้จักค่ะ", "rom": "yindee thi dai rujak kha", "tone": "polite", "speakerGender": "f", "note": "With polite particle ค่ะ for female speakers." }
      ]
    },
    "mizo": {
      "gloss": "hmuh tirh",
      "variants": [
        { "text": "Hmuh che ka lawm e", "note": "Lit. \"I'm glad to meet you.\"" }
      ]
    }
  }
