---
import ui from '../../content/ui/en.json';
---

<footer class="end">
  {ui.footer.line1}<br />
  <span class="sig">— {ui.footer.sig} —</span>
  <a
    class="src"
    href={ui.footer.sourceUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ui.footer.sourceLabel}
    title={ui.footer.sourceLabel}
  >
    <svg
      class="gh"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.04 1.78 2.72 1.27 3.38.97.1-.75.41-1.27.74-1.56-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.17a10.97 10.97 0 0 1 5.75 0c2.2-1.48 3.16-1.17 3.16-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.65.42.36.79 1.07.79 2.17v3.22c0 .31.21.66.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12.5.5h-.5z" />
    </svg>
  </a>
</footer>

<style>
  .end {
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-mute);
    line-height: 1.7;
  }
  .end .sig {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-style: normal;
    font-family: var(--font-sans);
    color: var(--gold-ink);
  }
  .end .src {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    color: var(--gold-ink);
    transition: color var(--dur-hover) ease, transform var(--dur-switch) var(--ease-out);
  }
  .end .src:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }
  .end .src:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 50%;
  }
  .end .gh {
    display: block;
  }
</style>
