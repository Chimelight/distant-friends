---
import ui from '../../content/ui/en.json';
---

<header class="masthead">
  <div class="mark">致 · 远 · 方</div>
  <h1 class="title">Phrases for <span class="amp">Distant</span> Friends</h1>
  <p class="tagline" set:html={ui.masthead.tagline}></p>
</header>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 44px;
    position: relative;
  }
  /* Title-page rule: a double hairline that yields at the centre… */
  .masthead::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 6px;
    background:
      linear-gradient(
          to right,
          var(--line) 0 calc(50% - 28px),
          transparent calc(50% - 28px) calc(50% + 28px),
          var(--line) calc(50% + 28px)
        )
        top / 100% 1px no-repeat,
      linear-gradient(
          to right,
          var(--line-soft) 0 calc(50% - 28px),
          transparent calc(50% - 28px) calc(50% + 28px),
          var(--line-soft) calc(50% + 28px)
        )
        bottom / 100% 1px no-repeat;
  }
  /* …to a small gold lozenge. */
  .masthead::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6.5px;
    transform: translateX(-50%) rotate(45deg);
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
  }
  .mark {
    /* local serifs only: a first-paint CJK label must not swap-shift (CLS) */
    font-family: var(--font-serif-local);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.6em;
    /* one letter-space of indent balances the trailing letter-space gap */
    text-indent: 0.6em;
    color: var(--gold-ink);
    text-transform: uppercase;
    margin-bottom: 24px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 2px;
    position: relative;
    animation: rise 0.6s var(--ease-out) backwards 0.05s;
  }
  /* inner hairline: the double frame of a seal, not a UI chip */
  .mark::before {
    content: "";
    position: absolute;
    inset: 2px;
    border: 1px solid var(--line-soft);
    border-radius: 1px;
    pointer-events: none;
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(40px, 7vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: var(--ink);
    /* trim the leading above the caps / below the baseline so the margins
       measure from the ink itself, like set metal type */
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }
  .title :global(.amp) {
    color: var(--accent);
    font-style: italic;
  }
  .tagline {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 17px;
    max-width: 520px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
    /* Entrance choreography: mark → tagline → stationery → toc. The title
     * stays out of it — animating the LCP element's opacity would push the
     * LCP timestamp to the animation's end. */
    animation: rise 0.6s var(--ease-out) backwards 0.16s;
  }
  .tagline :global(em) {
    font-style: italic;
    color: var(--accent);
  }
</style>
