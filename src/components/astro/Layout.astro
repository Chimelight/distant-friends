---
// Variable Fraunces: standard axes (wght + opsz). The full set added SOFT +
// WONK for one TocSide flourish at +120KB on the critical latin subsets —
// dropped in the M4 size pass (decision log 2026-06-12).
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/400-italic.css';
import '@fontsource/instrument-sans/500.css';

// CJK font-face boilerplate is huge (~112KB gzipped) and render-blocking if
// bundled with the page CSS. It ships as its own stylesheet, loaded without
// blocking paint; system CJK serifs cover the gap (stack in tokens.css).
import cjkFontsHref from '../../styles/fonts-cjk.css?url';

// Preload the two latin Fraunces faces: nearly all first-paint text uses
// them, and letting them race the render caused visible swap-shift (CLS).
// Instrument Sans latin joined the list in the R9 perf pass — its late swap
// reflowed every small-caps UI label above the fold (17KB well spent).
import frauncesNormalHref from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import frauncesItalicHref from '@fontsource-variable/fraunces/files/fraunces-latin-standard-italic.woff2?url';
import instrumentSansHref from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';

import '../../styles/tokens.css';
import '../../styles/typography.css';
import '../../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Distant Friends — phrases for friends across languages',
  description = 'A warm glossary of friendly phrases across languages, tuned to who you write to and how you want to sound.',
} = Astro.props;

// Canonical URL points at GitHub Pages; Vercel build is treated as preview.
const canonical = 'https://chimelight.github.io/distant-friends/';
const ogImage = `${canonical.replace(/\/$/, '')}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesNormalHref} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesItalicHref} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={instrumentSansHref} />
    <link rel="stylesheet" href={cjkFontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={cjkFontsHref} /></noscript>
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Distant Friends" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // FOUC defense: apply theme before stylesheet parse so first paint is
      // correct. Persisted as raw string by @nanostores/persistent under the
      // same key as $theme in src/lib/stores.ts.
      try {
        var t = localStorage.getItem('distant-friends:theme:v1');
        if (t === 'dark' || t === 'light') {
          document.documentElement.dataset.theme = t;
        }
      } catch (e) {}
    </script>
  </head>
  <body data-view="table">
    <script is:inline>
      // FOUC defense for view mode. Below the table breakpoint, lock to cards
      // regardless of stored preference (the toggle is hidden there). Above
      // it, honor the stored value or fall back to table.
      try {
        var v = localStorage.getItem('distant-friends:view:v1');
        var wide = window.matchMedia('(min-width: 640px)').matches;
        if (!wide) v = 'cards';
        else if (v !== 'cards' && v !== 'table') v = 'table';
        document.body.dataset.view = v;
      } catch (e) {}
    </script>
    <slot />

    {/* @vite-pwa/astro generates registerSW.js but no longer auto-injects it
        under Astro 7 (its peer support caps at Astro 5), so we register the
        service worker ourselves. PROD-only — the file isn't emitted by dev. */}
    {import.meta.env.PROD && (
      <script is:inline src={`${import.meta.env.BASE_URL}registerSW.js`}></script>
    )}
  </body>
</html>
