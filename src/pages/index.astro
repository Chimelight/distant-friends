---
import Layout from '../components/astro/Layout.astro';
import Masthead from '../components/astro/Masthead.astro';
import Footer from '../components/astro/Footer.astro';

import Stationery from '../components/svelte/Stationery.svelte';
import TocTop from '../components/svelte/TocTop.svelte';
import TocSide from '../components/svelte/TocSide.svelte';
import StickyBar from '../components/svelte/StickyBar.svelte';
import PhraseTable from '../components/svelte/PhraseTable.svelte';
import PhraseCards from '../components/svelte/PhraseCards.svelte';
import Toast from '../components/svelte/Toast.svelte';

import { LanguagesFile, ScenesFile, PhrasesFile } from '../lib/schema';
import languagesRaw from '../data/languages.json';
import scenesRaw from '../data/scenes.json';
import phrasesRaw from '../data/phrases';

// Build-time schema validation. A Zod error here fails `astro build`.
LanguagesFile.parse(languagesRaw);
ScenesFile.parse(scenesRaw);
PhrasesFile.parse(phrasesRaw);
---

<Layout>
  {/* client:idle islands only matter after a scroll or an action (StickyBar/
      TocSide appear past 420px; Toast follows a copy) — their hydration can
      wait so first-paint bandwidth goes to fonts and content. TocTop stays
      client:load: it is visible and clickable on the first screen, and a
      dead first click costs more than its few KB. */}
  <StickyBar client:idle />

  <div class="shell">
    <Masthead />

    <Stationery client:load />

    <TocTop client:load />

    <main>
      <PhraseTable client:load />
      <PhraseCards client:load />
    </main>

    <Footer />
  </div>

  <TocSide client:idle />
  <Toast client:idle />
</Layout>
