---
import Layout from '../components/astro/Layout.astro';

const home = import.meta.env.BASE_URL;
---

<Layout title="Lost in the post — Distant Friends">
  <div class="lost">
    <p class="seal" lang="zh">致 · 远 · 方</p>
    <p class="num">404</p>
    <h1>This letter went astray.</h1>
    <p class="line">
      The page you were looking for isn't here — perhaps the address smudged
      in the rain.
    </p>
    <a class="back" href={home}>Return to the glossary ↗</a>
  </div>
</Layout>

<style>
  .lost {
    min-height: 70vh;
    max-width: 560px;
    margin: 0 auto;
    padding: 18vh 24px 0;
    text-align: center;
  }
  /* the site's seal, so even a lost letter is recognizably ours —
     mirrors the Masthead chip */
  .seal {
    display: inline-block;
    /* local serifs only — mirrors the Masthead mark (no swap-shift) */
    font-family: var(--font-serif-local);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.6em;
    text-indent: 0.6em; /* recentre: tracking adds a trailing gap */
    color: var(--gold-ink);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 7px 14px;
    margin: 0 0 26px;
    position: relative;
  }
  /* inner hairline: double seal frame, mirrors the Masthead mark */
  .seal::before {
    content: "";
    position: absolute;
    inset: 2px;
    border: 1px solid var(--line-soft);
    border-radius: 1px;
    pointer-events: none;
  }
  .num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    letter-spacing: 0.3em;
    color: var(--gold-ink);
    margin: 0 0 18px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 420;
    font-size: clamp(26px, 5vw, 38px);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 36px;
  }
  .back {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--dur-hover) var(--ease-out);
  }
  .back:hover {
    opacity: 0.75;
  }
  .back:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
